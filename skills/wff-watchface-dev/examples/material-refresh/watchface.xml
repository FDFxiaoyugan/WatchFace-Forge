<?xml version="1.0" encoding="UTF-8"?>
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:08:32"/>
  <Scene backgroundColor="#ff0E1512">
    <Group name="root" x="0" y="0" width="450" height="450">
      <!-- AMBIENT: 整组压暗 -->
      <Variant mode="AMBIENT" target="alpha" value="60"/>

      <!-- 主胶囊: primary container -->
      <PartDraw x="55" y="128" width="340" height="144" name="pill">
        <RoundRectangle x="0" y="0" width="340" height="144" cornerRadiusX="72" cornerRadiusY="72">
          <Fill color="#ff2E6B5C"/>
        </RoundRectangle>
      </PartDraw>

      <!-- 时间: B 通道 (PartText + 系统字体 + floor 表达式, 真机 AB 实证) -->
      <PartText x="55" y="128" width="340" height="144" name="time">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="78" weight="BOLD" color="#ffF5F8F6">
            <Template><![CDATA[%s:%s]]><Parameter expression="floor([HOUR_1_12])"/><Parameter expression="floor([MINUTE])"/></Template>
          </Font>
        </Text>
      </PartText>

      <!-- 中式日期 (已实证) -->
      <PartText x="0" y="286" width="450" height="30" name="date">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="22" color="#ffA3C9BD">
            <Template><![CDATA[%s月%s日 %s]]><Parameter expression="floor([MONTH])"/><Parameter expression="floor([MONTH_DAY])"/><Parameter expression="[DAY_OF_WEEK_S]"/></Template>
          </Font>
        </Text>
      </PartText>

      <!-- 左胶囊: 鞋 + 步数 -->
      <PartDraw x="85" y="330" width="130" height="58" name="chip_steps">
        <RoundRectangle x="0" y="0" width="130" height="58" cornerRadiusX="29" cornerRadiusY="29">
          <Fill color="#ff1C4A3E"/>
        </RoundRectangle>
      </PartDraw>
      <PartImage x="99" y="348" width="28" height="21" name="ic_steps"><Image resource="ic_steps"/></PartImage>
      <PartText x="131" y="330" width="76" height="58" name="steps_val">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#ffF5F8F6">
            <Template><![CDATA[%s]]><Parameter expression="[STEP_COUNT]"/></Template>
          </Font>
        </Text>
      </PartText>

      <!-- 右胶囊: 闪电 + 电量 -->
      <PartDraw x="235" y="330" width="130" height="58" name="chip_batt">
        <RoundRectangle x="0" y="0" width="130" height="58" cornerRadiusX="29" cornerRadiusY="29">
          <Fill color="#ff1C4A3E"/>
        </RoundRectangle>
      </PartDraw>
      <PartImage x="250" y="347" width="18" height="23" name="ic_batt"><Image resource="ic_batt"/></PartImage>
      <PartText x="272" y="330" width="86" height="58" name="batt_val">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#ffF5F8F6">
            <Template><![CDATA[%s%%]]><Parameter expression="[BATTERY_PERCENT]"/></Template>
          </Font>
        </Text>
      </PartText>
    </Group>
  </Scene>
</WatchFace>
