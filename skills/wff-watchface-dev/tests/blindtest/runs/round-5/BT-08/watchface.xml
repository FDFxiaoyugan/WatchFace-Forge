<?xml version="1.0"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>

    <!-- 容器版：编辑器 UI 元数据（displayName 裸资源名，R30） -->
    <UserConfigurations>
        <ColorConfiguration id="themeColor" displayName="theme_color" defaultValue="0">
            <ColorOption id="0" displayName="color_cyan" colors="#ff00E5FF"/>
            <ColorOption id="1" displayName="color_gold" colors="#ffFFC940"/>
            <ColorOption id="2" displayName="color_red" colors="#ffFF5555"/>
        </ColorConfiguration>
        <ListConfiguration id="clockStyle" displayName="clock_style" defaultValue="0">
            <ListOption id="0" displayName="style_thin"/>
            <ListOption id="1" displayName="style_bold"/>
        </ListConfiguration>
        <BooleanConfiguration id="showSeconds" displayName="show_seconds" defaultValue="FALSE"/>
    </UserConfigurations>

    <Scene backgroundColor="#ff0a0d12">
        <!-- 日期 -->
        <PartText x="105" y="52" width="240" height="36">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="NORMAL" color="#ff9aa5b1">
                    <Template>%s, %s %s
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[MONTH_S]"/>
                        <Parameter expression="[DAY]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- 渲染版：时钟样式切换（细/粗，R37） -->
        <ListConfiguration id="clockStyle">
            <ListOption id="0">
                <DigitalClock x="0" y="0" width="450" height="450">
                    <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                              x="0" y="150" width="450" height="115" alpha="255">
                        <Variant mode="AMBIENT" target="alpha" value="0"/>
                        <Font family="SYNC_TO_DEVICE" size="92" weight="THIN" color="[CONFIGURATION.themeColor.0]"/>
                    </TimeText>
                    <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                              x="0" y="150" width="450" height="115" alpha="0">
                        <Variant mode="AMBIENT" target="alpha" value="255"/>
                        <Font family="SYNC_TO_DEVICE" size="92" weight="THIN" color="#ff9aa5b1"/>
                    </TimeText>
                </DigitalClock>
            </ListOption>
            <ListOption id="1">
                <DigitalClock x="0" y="0" width="450" height="450">
                    <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                              x="0" y="150" width="450" height="115" alpha="255">
                        <Variant mode="AMBIENT" target="alpha" value="0"/>
                        <Font family="SYNC_TO_DEVICE" size="92" weight="BOLD" color="[CONFIGURATION.themeColor.0]"/>
                    </TimeText>
                    <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                              x="0" y="150" width="450" height="115" alpha="0">
                        <Variant mode="AMBIENT" target="alpha" value="255"/>
                        <Font family="SYNC_TO_DEVICE" size="92" weight="BOLD" color="#ff9aa5b1"/>
                    </TimeText>
                </DigitalClock>
            </ListOption>
        </ListConfiguration>

        <!-- 渲染版：显示秒开关（只放 TRUE，FALSE=不渲染，R37） -->
        <BooleanConfiguration id="showSeconds">
            <BooleanOption id="TRUE">
                <DigitalClock x="0" y="0" width="450" height="450">
                    <TimeText format="ss" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                              x="0" y="315" width="450" height="55" alpha="255">
                        <Variant mode="AMBIENT" target="alpha" value="0"/>
                        <Font family="SYNC_TO_DEVICE" size="40" weight="NORMAL" color="[CONFIGURATION.themeColor.0]"/>
                    </TimeText>
                </DigitalClock>
            </BooleanOption>
        </BooleanConfiguration>

        <!-- 左槽底板（Scene 层，恒显示，R26；颜色随主题） -->
        <PartDraw x="65" y="290" width="90" height="90">
            <Ellipse x="0" y="0" width="90" height="90">
                <Stroke thickness="3" color="[CONFIGURATION.themeColor.0]"/>
            </Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="40"/>
        </PartDraw>

        <!-- 左槽：心率（slotId 从 0 起，R38；BoundingShape 局部坐标，R28） -->
        <ComplicationSlot x="65" y="290" width="90" height="90" slotId="0"
                          supportedTypes="SHORT_TEXT EMPTY"
                          displayName="slot_left" isCustomizable="TRUE">
            <DefaultProviderPolicy defaultSystemProvider="HEART_RATE"
                                   defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingOval x="0" y="0" width="90" height="90" outlinePadding="2.0"/>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="90" height="90" tintColor="[CONFIGURATION.themeColor.0]">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="24" weight="BOLD">
                            <Template>%s
                                <Parameter expression="[COMPLICATION.TEXT]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="30" width="90" height="30">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" color="#ff7E93A8">--</Font>
                    </Text>
                </PartText>
            </Complication>
            <Variant mode="AMBIENT" target="alpha" value="40"/>
        </ComplicationSlot>

        <!-- 右槽底板（Scene 层，恒显示） -->
        <PartDraw x="295" y="290" width="90" height="90">
            <Ellipse x="0" y="0" width="90" height="90">
                <Stroke thickness="3" color="[CONFIGURATION.themeColor.0]"/>
            </Ellipse>
            <Variant mode="AMBIENT" target="alpha" value="40"/>
        </PartDraw>

        <!-- 右槽：步数 -->
        <ComplicationSlot x="295" y="290" width="90" height="90" slotId="1"
                          supportedTypes="SHORT_TEXT EMPTY"
                          displayName="slot_right" isCustomizable="TRUE">
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT"
                                   defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingOval x="0" y="0" width="90" height="90" outlinePadding="2.0"/>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="90" height="90" tintColor="[CONFIGURATION.themeColor.0]">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="24" weight="BOLD">
                            <Template>%s
                                <Parameter expression="[COMPLICATION.TEXT]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="30" width="90" height="30">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" color="#ff7E93A8">--</Font>
                    </Text>
                </PartText>
            </Complication>
            <Variant mode="AMBIENT" target="alpha" value="40"/>
        </ComplicationSlot>
    </Scene>
</WatchFace>
