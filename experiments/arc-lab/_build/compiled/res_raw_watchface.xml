<?xml version="1.0"?>
<!-- 弧线语义对照实验: 验证 0°=12点方向 顺时针为正 -->
<!-- 四角四分之一弧 + 中央跨零拱形, 每道标注参数 -->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>
    <Scene backgroundColor="#ff101418">

        <PartText x="0" y="6" width="450" height="40">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="26" weight="BOLD" color="#fff2f5f8">0=12 o'clock CW</Font></Text>
        </PartText>

        <!-- 左上红: 0→90 (预期 12点→3点 右上四分之一) -->
        <PartDraw x="30" y="60" width="100" height="100">
            <Arc centerX="50" centerY="50" width="100" height="100" startAngle="0" endAngle="90">
                <Stroke color="#ffff5555" thickness="6" cap="ROUND"/>
            </Arc>
        </PartDraw>
        <PartText x="30" y="164" width="100" height="30">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="20" color="#ff9aa0a8">0-90</Font></Text>
        </PartText>

        <!-- 右上青: 90→180 (预期 3点→6点 右下四分之一) -->
        <PartDraw x="320" y="60" width="100" height="100">
            <Arc centerX="50" centerY="50" width="100" height="100" startAngle="90" endAngle="180">
                <Stroke color="#ff00e5ff" thickness="6" cap="ROUND"/>
            </Arc>
        </PartDraw>
        <PartText x="320" y="164" width="100" height="30">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="20" color="#ff9aa0a8">90-180</Font></Text>
        </PartText>

        <!-- 左下金: 180→270 (预期 6点→9点 左下四分之一) -->
        <PartDraw x="30" y="200" width="100" height="100">
            <Arc centerX="50" centerY="50" width="100" height="100" startAngle="180" endAngle="270">
                <Stroke color="#ffffc940" thickness="6" cap="ROUND"/>
            </Arc>
        </PartDraw>
        <PartText x="30" y="304" width="100" height="30">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="20" color="#ff9aa0a8">180-270</Font></Text>
        </PartText>

        <!-- 右下绿: 270→360 (预期 9点→12点 左上四分之一) -->
        <PartDraw x="320" y="200" width="100" height="100">
            <Arc centerX="50" centerY="50" width="100" height="100" startAngle="270" endAngle="360">
                <Stroke color="#ff3ddc84" thickness="6" cap="ROUND"/>
            </Arc>
        </PartDraw>
        <PartText x="320" y="304" width="100" height="30">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="20" color="#ff9aa0a8">270-360</Font></Text>
        </PartText>

        <!-- 中央白拱: -90→90 跨零 (目标形状: 上半拱 开口朝下) -->
        <PartDraw x="125" y="330" width="200" height="110">
            <Arc centerX="100" centerY="55" width="200" height="110" startAngle="-90" endAngle="90">
                <Stroke color="#fff2f5f8" thickness="6" cap="ROUND"/>
            </Arc>
        </PartDraw>
        <PartText x="125" y="408" width="200" height="30">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="20" color="#ff9aa0a8">-90-90</Font></Text>
        </PartText>

    </Scene>
</WatchFace>
